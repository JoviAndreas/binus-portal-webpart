{
  "$schema": "https://developer.microsoft.com/json-schemas/heft/v0/heft.schema.json",
  "phasesByName": {
    "build": {
      "cleanFiles": [
        { "sourcePath": "dist" },
        { "sourcePath": "temp" },
        { "sourcePath": "lib" }
      ],
      "tasksByName": {
        "webpack": {
          "taskPlugin": {
            "pluginPackage": "@rushstack/heft-webpack5-plugin",
            "pluginName": "webpack5-plugin",
            "options": {
              "configurationPath": "./webpack.serve.js"
            }
          }
        }
      }
    }
  }
}
