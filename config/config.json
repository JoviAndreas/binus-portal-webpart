{
  "$schema": "https://developer.microsoft.com/json-schemas/spfx-build/config.2.0.schema.json",
  "version": "2.0",
  "bundles": {
    "binus-hero-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/binusHero/BinusHeroWebPart.js",
          "manifest": "./src/webparts/binusHero/BinusHeroWebPart.manifest.json"
        }
      ]
    },
    "binus-app-launcher-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/binusAppLauncher/BinusAppLauncherWebPart.js",
          "manifest": "./src/webparts/binusAppLauncher/BinusAppLauncherWebPart.manifest.json"
        }
      ]
    },
    "binus-homepage-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/binusHomepage/BinusHomepageWebPart.js",
          "manifest": "./src/webparts/binusHomepage/BinusHomepageWebPart.manifest.json"
        }
      ]
    },
    "binus-pages-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/binusPages/BinusPagesWebPart.js",
          "manifest": "./src/webparts/binusPages/BinusPagesWebPart.manifest.json"
        }
      ]
    },
    "binus-zoombot-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/binusZoomBot/BinusZoomBotWebPart.js",
          "manifest": "./src/webparts/binusZoomBot/BinusZoomBotWebPart.manifest.json"
        }
      ]
    },
    "dams-vbl-upload-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/damsVblUpload/DamsVblUploadWebPart.js",
          "manifest": "./src/webparts/damsVblUpload/DamsVblUploadWebPart.manifest.json"
        }
      ]
    },
    "dams-vbl-admin-web-part": {
      "components": [
        {
          "entrypoint": "./lib/webparts/damsVblAdmin/DamsVblAdminWebPart.js",
          "manifest": "./src/webparts/damsVblAdmin/DamsVblAdminWebPart.manifest.json"
        }
      ]
    }
  },
  "externals": {},
  "localizedResources": {
    "BinusHeroWebPartStrings": "lib/webparts/binusHero/loc/{locale}.js",
    "BinusAppLauncherWebPartStrings": "lib/webparts/binusAppLauncher/loc/{locale}.js",
    "BinusHomepageWebPartStrings": "lib/webparts/binusHomepage/loc/{locale}.js",
    "BinusPagesWebPartStrings": "lib/webparts/binusPages/loc/{locale}.js",
    "BinusZoomBotWebPartStrings": "lib/webparts/binusZoomBot/loc/{locale}.js",
    "DamsVblUploadWebPartStrings": "lib/webparts/damsVblUpload/loc/{locale}.js",
    "DamsVblAdminWebPartStrings": "lib/webparts/damsVblAdmin/loc/{locale}.js"
  }
}
