{
  "name": "binus-portal-webpart",
  "version": "1.0.28",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "lib/index.js",
  "scripts": {
    "clean": "heft clean",
    "serve": "heft build-watch --serve",
    "build": "heft build",
    "bundle": "heft build --production",
    "packagesppkg": "gulp bundle --ship && gulp package-solution --ship",
    "deploy": "npm run packagesppkg && m365 spo app add --filePath sharepoint/solution/binus-portal-webpart.sppkg --appCatalogUrl https://binusianorg.sharepoint.com/sites/appcatalog --overwrite && m365 spo app deploy --name binus-portal-webpart.sppkg --appCatalogUrl https://binusianorg.sharepoint.com/sites/appcatalog"
  },
  "dependencies": {
    "@microsoft/sp-component-base": "1.23.0",
    "@microsoft/sp-core-library": "1.23.0",
    "@microsoft/sp-http": "1.23.0",
    "@microsoft/sp-lodash-subset": "1.23.0",
    "@microsoft/sp-office-ui-fabric-core": "1.23.0",
    "@microsoft/sp-property-pane": "1.23.0",
    "@microsoft/sp-webpart-base": "1.23.0",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.23.0",
    "@microsoft/eslint-plugin-spfx": "1.23.0",
    "@microsoft/rush-stack-compiler-4.7": "0.1.0",
    "@microsoft/sp-build-web": "1.23.0",
    "@microsoft/sp-module-interfaces": "1.23.0",
    "@pnp/cli-microsoft365": "^11.7.1",
    "@rushstack/eslint-config": "3.3.0",
    "@rushstack/heft": "1.2.17",
    "@rushstack/heft-webpack5-plugin": "^1.3.18",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/webpack-env": "~1.18.0",
    "ajv": "^8.17.1",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.6.0",
    "gulp": "4.0.2",
    "sass": "^1.72.0",
    "typescript": "4.9.5"
  }
}
